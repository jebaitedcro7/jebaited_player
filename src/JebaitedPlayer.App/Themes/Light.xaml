<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Svijetla tema: isti ključevi kao Dark.xaml. Kontrole i kartice preko videa ostaju tamne (vidi ThemeManager). -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1F8A3B" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#40000000" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#24000000" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#D3EEDA" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4D000000" />

    <!-- Poluprozirna podloga popisa na početnom ekranu (preko svemirske pozadine). -->
    <SolidColorBrush x:Key="HomeCardBrush" Color="#B3FFFFFF" />
    <!-- N4: posvjetljenje preko vlastite slike pozadine (kartice i tekst ostaju čitljivi). -->
    <SolidColorBrush x:Key="HomeImageDimBrush" Color="#73F4F6FA" />

    <!-- Sjaj iza loga na početnom ekranu i u odabiru jezika. -->
    <RadialGradientBrush x:Key="LogoGlowBrush">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
