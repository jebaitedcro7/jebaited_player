<UserControl x:Class="JebaitedPlayer.Views.EqualizerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure">
    <!-- Equalizer (ciklus 1), zajednički za postavke i mini player (ciklus 2). -->
    <StackPanel>
        <CheckBox x:Name="EnabledBox" Content="{loc:T settings.eqEnable}" Margin="0,4,0,0" />
        <StackPanel x:Name="Panel" Margin="0,10,0,0">
            <WrapPanel>
                <TextBlock x:Name="PresetLabel" Text="{loc:T settings.eqPreset}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="PresetButton" Style="{StaticResource ChoiceButton}" Click="OnPresetClick" MinWidth="170" />
                <Button x:Name="ResetButton" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.reset}"
                        Click="OnReset" Margin="12,0,0,0" VerticalAlignment="Center" />
            </WrapPanel>
            <StackPanel x:Name="Bands" Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Left" />
        </StackPanel>
    </StackPanel>
</UserControl>
