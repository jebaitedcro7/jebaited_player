<Window x:Class="JebaitedPlayer.Views.ControlsOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        xmlns:views="clr-namespace:JebaitedPlayer.Views"
        Title="{loc:T controls.windowTitle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" AllowDrop="True" UseLayoutRounding="True"
        Width="800" Height="116"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}">

    <!-- Kontrole leže na videu, pa su uvijek tamne, bez obzira na temu. -->
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Dark.xaml" />
    </Window.Resources>

    <!-- Prozor s kontrolama iznad videa. Gradijent nikad nije potpuno proziran, da bi primao miš. -->
    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#03000000" Offset="0" />
                <GradientStop Color="#8C000000" Offset="0.45" />
                <GradientStop Color="#D0000000" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="20,0,20,8" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Vremenska traka. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="58" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="58" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PositionText}" Style="{StaticResource TimeText}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" />
                <Slider x:Name="Timeline" Grid.Column="1" Style="{StaticResource TimelineSlider}" Margin="12,0"
                        Minimum="0" Maximum="{Binding TimelineMaximum}" Value="{Binding Position, Mode=OneWay}"
                        AutomationProperties.Name="{loc:T controls.timeline}" />

                <!-- Pod mišem: vrijeme na koje vodi klik (oblačić iznad trake) i oznaka na traci. Ne prima miš. -->
                <Canvas x:Name="SeekPreview" Grid.Column="1" Margin="12,0" IsHitTestVisible="False" Visibility="Collapsed">
                    <Border x:Name="SeekMarker" Width="2" Height="12" Background="#E6FFFFFF" CornerRadius="1" Canvas.Top="8" />
                    <Border x:Name="SeekBubble" Background="#F0202020" BorderBrush="#40FFFFFF" BorderThickness="1"
                            CornerRadius="5" Padding="8,3" Canvas.Top="-26">
                        <TextBlock x:Name="SeekBubbleText" FontSize="13" Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                </Canvas>

                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource TimeText}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" />
            </Grid>

            <!-- Gumbi. -->
            <Grid Grid.Row="1" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" FontSize="20" Content="{Binding PlayPauseGlyph}"
                            Command="{Binding PlayPauseCommand}" ToolTip="{loc:T controls.playPause}" />
                    <!-- 2.1.7: kotačić miša mijenja glasnoću samo iznad ovog dijela (gumb, traka i postotak). -->
                    <StackPanel x:Name="VolumeArea" Orientation="Horizontal" Background="Transparent">
                        <Button Style="{StaticResource IconButton}" Margin="8,0,0,0" Content="{Binding VolumeGlyph}"
                                Command="{Binding MuteCommand}" ToolTip="{loc:T controls.mute}" />
                        <Slider Style="{StaticResource PlayerSlider}" Width="96" Margin="4,0,0,0" VerticalAlignment="Center"
                                Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                Value="{Binding Volume, Mode=TwoWay}" ToolTip="{loc:T controls.volume}" />
                        <TextBlock Text="{Binding VolumeText}" Style="{StaticResource TimeText}" Margin="10,0,0,0" MinWidth="40"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <views:LiveBadge x:Name="LiveMark" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SpeedButton" Style="{StaticResource IconButton}" Content="{Binding Extras.SpeedText}"
                            FontFamily="{DynamicResource UiFont}" FontSize="13" Width="Auto" MinWidth="54" Margin="0,0,4,0"
                            ToolTip="{loc:T controls.speed}" Click="OnSpeedClick"
                            Visibility="{Binding Extras.IsSpeedChanged, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource IconButton}" Content="{Binding Library.FavoriteGlyph}"
                            ToolTip="{Binding Library.FavoriteToolTip}" Command="{Binding Library.ToggleFavoriteCommand}" Margin="0,0,4,0"
                            Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="AudioButton" Style="{StaticResource IconButton}" Content="&#xE8D6;" ToolTip="{loc:T controls.audioTrack}"
                            Click="OnAudioClick" Margin="0,0,4,0"
                            Visibility="{Binding Extras.HasMultipleAudio, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="{loc:T controls.playlist}"
                            Click="OnPlaylistClick" Margin="0,0,4,0"
                            Visibility="{Binding Library.HasPlaylist, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="SubtitlesButton" Style="{StaticResource IconButton}" Content="&#xE7F0;"
                            ToolTip="{loc:T controls.subtitles}" Click="OnSubtitlesClick" Margin="0,0,4,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Command="{Binding OpenCommand}"
                            ToolTip="{loc:T controls.open}" />
                    <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Content="{Binding FullscreenGlyph}"
                            Command="{Binding FullscreenCommand}" ToolTip="{loc:T controls.fullscreen}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
