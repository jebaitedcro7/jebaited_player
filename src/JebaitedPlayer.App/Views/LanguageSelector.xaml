<UserControl x:Class="JebaitedPlayer.Views.LanguageSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Glavni jezici (EN, DE, HR) su uvijek vidljivi; ostali su u izborniku "Više jezika". -->
    <StackPanel>
        <UniformGrid x:Name="PrimaryPanel" Rows="1" Margin="-4,0" />
        <Button x:Name="MoreButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                Click="OnMoreClick" />
    </StackPanel>
</UserControl>
