<Window x:Class="JebaitedPlayer.Views.ControlsOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="jebaited_player kontrole"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" AllowDrop="True" UseLayoutRounding="True"
        Width="800" Height="116"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}">

    <!-- Kontrole leže na videu, pa su uvijek tamne, bez obzira na temu. -->
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Dark.xaml" />
    </Window.Resources>

    <!-- Prozor s kontrolama iznad videa. Gradijent nikad nije potpuno proziran, da bi primao miš. -->
    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#03000000" Offset="0" />
                <GradientStop Color="#8C000000" Offset="0.45" />
                <GradientStop Color="#D0000000" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="20,0,20,8" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Vremenska traka. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PositionText}" Style="{StaticResource TimeText}" HorizontalAlignment="Left" />
                <Slider x:Name="Timeline" Grid.Column="1" Style="{StaticResource PlayerSlider}" Margin="12,0"
                        Minimum="0" Maximum="{Binding TimelineMaximum}" Value="{Binding Position, Mode=OneWay}" />
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource TimeText}" HorizontalAlignment="Right" />
            </Grid>

            <!-- Gumbi. -->
            <Grid Grid.Row="1" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" FontSize="20" Content="{Binding PlayPauseGlyph}"
                            Command="{Binding PlayPauseCommand}" ToolTip="Reproduciraj / pauziraj (Razmaknica)" />
                    <Button Style="{StaticResource IconButton}" Margin="8,0,0,0" Content="{Binding VolumeGlyph}"
                            Command="{Binding MuteCommand}" ToolTip="Isključi / uključi zvuk (M)" />
                    <Slider Style="{StaticResource PlayerSlider}" Width="96" Margin="4,0,0,0" VerticalAlignment="Center"
                            Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                            Value="{Binding Volume, Mode=TwoWay}" ToolTip="Glasnoća (↑ / ↓)" />
                    <TextBlock Text="{Binding VolumeText}" Style="{StaticResource TimeText}" Margin="10,0,0,0" MinWidth="40"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SpeedButton" Style="{StaticResource IconButton}" Content="{Binding Extras.SpeedText}"
                            FontFamily="{DynamicResource UiFont}" FontSize="13" Width="Auto" MinWidth="54" Margin="0,0,4,0"
                            ToolTip="Brzina reprodukcije (+ / − / Backspace)" Click="OnSpeedClick"
                            Visibility="{Binding Extras.IsSpeedChanged, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource IconButton}" Content="{Binding Library.FavoriteGlyph}"
                            ToolTip="{Binding Library.FavoriteToolTip}" Command="{Binding Library.ToggleFavoriteCommand}" Margin="0,0,4,0"
                            Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="AudioButton" Style="{StaticResource IconButton}" Content="&#xE8D6;" ToolTip="Audio traka (B)"
                            Click="OnAudioClick" Margin="0,0,4,0"
                            Visibility="{Binding Extras.HasMultipleAudio, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="Popis epizoda (L)"
                            Click="OnPlaylistClick" Margin="0,0,4,0"
                            Visibility="{Binding Library.HasPlaylist, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="SubtitlesButton" Style="{StaticResource IconButton}" Content="&#xE7F0;"
                            ToolTip="Titlovi" Click="OnSubtitlesClick" Margin="0,0,4,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Command="{Binding OpenCommand}"
                            ToolTip="Otvori datoteku (Ctrl+O)" />
                    <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Content="{Binding FullscreenGlyph}"
                            Command="{Binding FullscreenCommand}" ToolTip="Cijeli zaslon (F)" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
