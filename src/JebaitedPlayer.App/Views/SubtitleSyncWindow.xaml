<Window x:Class="JebaitedPlayer.Views.SubtitleSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        Title="{loc:T sync.title}"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <!-- Gumbi su uvijek vidljivi; ostatak se pomiče ako prozor ne stane na zaslon. -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="22,0,22,16">
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource MenuBorderBrush}" Margin="0,0,0,14" />
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="{loc:T sync.reset}" Click="OnReset"
                    ToolTip="{loc:T sync.resetTip}" />
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="{loc:T sync.save}"
                    IsEnabled="{Binding CanSaveSynced}" Click="OnSave" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T common.close}" Click="OnClose" Margin="0,0,0,6" />
        </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="22,18,22,16" Width="540">
        <TextBlock Text="{Binding SelectedTrackText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding TimingSummary}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />

        <!-- 1. Automatski prema govoru -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T sync.autoHeader}" />
        <Grid x:Name="AutoPanel" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}" Margin="0,6,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButton}" Padding="14,7" Margin="12,0,0,0" VerticalAlignment="Top"
                    Command="{Binding SyncCommand}">
                <TextBlock Text="{loc:T sync.autoButton}" FontWeight="SemiBold" />
            </Button>
        </Grid>

        <!-- 2. Pomak -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T sync.delayHeader}" />
        <TextBlock Style="{StaticResource HintText}"
                   Text="{loc:T sync.delayHint}" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="−5 s" Tag="-5000" Click="OnDelayStep" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="−1 s" Tag="-1000" Click="OnDelayStep" />
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{loc:T sync.stepMinusHalf}" Tag="-500" Click="OnDelayStep" />
            <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="{loc:T sync.stepMinusTenth}" Tag="-100" Click="OnDelayStep" />
            <DockPanel Grid.Column="4" Margin="0,0,6,6">
                <TextBlock DockPanel.Dock="Right" Text="s" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="DelayBox" Text="{Binding DelaySecondsInput, UpdateSourceTrigger=LostFocus}" TextAlignment="Right"
                         ToolTip="{loc:T sync.delayBoxTip}" />
            </DockPanel>
            <Button Grid.Column="5" Style="{StaticResource SecondaryButton}" Content="{loc:T sync.stepPlusTenth}" Tag="100" Click="OnDelayStep" />
            <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Content="{loc:T sync.stepPlusHalf}" Tag="500" Click="OnDelayStep" />
            <Button Grid.Column="7" Style="{StaticResource SecondaryButton}" Content="+1 s" Tag="1000" Click="OnDelayStep" />
            <Button Grid.Column="8" Style="{StaticResource SecondaryButton}" Content="+5 s" Tag="5000" Click="OnDelayStep" Margin="0,0,0,6" />
        </Grid>

        <!-- 3. Postupno -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T sync.gradualHeader}" />
        <TextBlock Style="{StaticResource HintText}"
                   Text="{loc:T sync.gradualHint}" />
        <WrapPanel Margin="0,10,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T sync.gradualLate}" Click="OnGradualLate"
                    ToolTip="{loc:T sync.gradualLateTip}" />
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T sync.gradualEarly}" Click="OnGradualEarly"
                    ToolTip="{loc:T sync.gradualEarlyTip}" />
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T sync.gradualReset}" Click="OnGradualReset" />
        </WrapPanel>
        <TextBlock Text="{Binding GradualText}" Style="{StaticResource HintText}" Margin="0,2,0,0" />

        <!-- 4. Po replici -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T sync.anchorHeader}" />
        <TextBlock Style="{StaticResource HintText}"
                   Text="{loc:T sync.anchorHint}" />
        <DockPanel Margin="0,10,0,6" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="{loc:T sync.showCues}" Click="OnRefreshCues" />
            <Button DockPanel.Dock="Right" x:Name="AnchorButton" Style="{StaticResource AccentButton}" Padding="14,7" Margin="0,0,0,6"
                    Click="OnAddAnchor" IsEnabled="False">
                <TextBlock Text="{loc:T sync.anchorButton}" FontWeight="SemiBold" />
            </Button>
        </DockPanel>
        <ListBox x:Name="CueList" ItemsSource="{Binding NearbyCues}" Height="170" MouseDoubleClick="OnCueDoubleClick"
                 SelectionChanged="OnCueSelectionChanged">
            <!-- Zajednički stil popisa nema pomicanje; ovdje replika može biti više nego što stane. -->
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="72" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!-- Replika koja je sad na ekranu (ili zadnja prije ovog mjesta). -->
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ItemsControl ItemsSource="{Binding Anchors}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{loc:T subSettings.remove}" Click="OnRemoveAnchor" Tag="{Binding}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel LastChildFill="True" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{loc:T sync.clearPoints}" Click="OnClearAnchors" VerticalAlignment="Top" />
            <TextBlock Text="{Binding AnchorStatus}" Style="{StaticResource HintText}" Margin="0" />
        </DockPanel>

        <!-- Napredno -->
        <Button Style="{StaticResource LinkButton}" Content="{loc:T sync.advanced}" Click="OnToggleAdvanced" HorizontalAlignment="Left" Margin="0,16,0,0" />
        <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T sync.fpsHeader}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="{loc:T sync.fpsHint}" />
            <WrapPanel x:Name="PresetPanel" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{loc:T sync.speedFactor}" VerticalAlignment="Center" />
                <TextBox x:Name="SpeedBox" Width="110" Margin="10,0,0,0" Text="{Binding SpeedInput, UpdateSourceTrigger=LostFocus}"
                         TextAlignment="Right" />
                <TextBlock Text="{loc:T sync.speedFactorHint}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T sync.zxHeader}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="{loc:T sync.zxHint}" />
            <WrapPanel Margin="0,10,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:T sync.markAudio}" Click="OnMarkAudio" />
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:T sync.markSubtitle}" Click="OnMarkSubtitle" />
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:T sync.clearPoints}" Click="OnResetPoints" />
            </WrapPanel>
            <TextBlock Text="{Binding SyncStatus}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
