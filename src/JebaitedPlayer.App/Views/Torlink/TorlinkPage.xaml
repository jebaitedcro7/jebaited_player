<UserControl x:Class="JebaitedPlayer.Views.Torlink.TorlinkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
             Focusable="False" UseLayoutRounding="True">

    <!-- 2.2.14: zasebna Torlink početna stranica (zamjenjuje početni ekran dok je otvorena). Gumb Home vraća na početni ekran. -->
    <Grid Background="{DynamicResource PanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Gornja traka -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <Button x:Name="HomeButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Padding="14,6"
                        Click="OnHomeClick" ToolTip="{loc:T torlink.homeTooltip}" AutomationProperties.Name="{loc:T torlink.home}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="{DynamicResource IconFont}" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T torlink.home}" Margin="8,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Left" Text="{loc:T torlink.name}" FontSize="17" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{loc:T torlink.subtitle}" Margin="10,2,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <WrapPanel x:Name="SourceChips" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- Obavijest (Torlink se ne može pokrenuti, nije instaliran, ponovno pokrenut) -->
        <Border x:Name="BannerBox" Grid.Row="1" Visibility="Collapsed" Padding="14,8" Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="BannerButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,4" Click="OnBannerClick" Margin="12,0,0,0" />
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Sredina: lijevo kategorije i filteri, desno pretraga i rezultati -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="0,0,1,0" Padding="12,12,10,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <RadioButton x:Name="CatAll" GroupName="TorlinkCat" Tag="all" Content="{loc:T torlink.cat.all}" IsChecked="True" Margin="0,2" Checked="OnCategoryChecked" />
                        <RadioButton GroupName="TorlinkCat" Tag="movies" Content="{loc:T torlink.cat.movies}" Margin="0,2" Checked="OnCategoryChecked" />
                        <RadioButton GroupName="TorlinkCat" Tag="tv" Content="{loc:T torlink.cat.tv}" Margin="0,2" Checked="OnCategoryChecked" />
                        <RadioButton GroupName="TorlinkCat" Tag="anime" Content="{loc:T torlink.cat.anime}" Margin="0,2" Checked="OnCategoryChecked" />
                        <RadioButton GroupName="TorlinkCat" Tag="games" Content="{loc:T torlink.cat.games}" Margin="0,2" Checked="OnCategoryChecked" />

                        <TextBlock Text="{loc:T torlink.filters}" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
                        <CheckBox x:Name="LiveOnlyBox" Content="{loc:T torlink.liveOnly}" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />

                        <TextBlock Text="{loc:T torlink.functions}" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T torlink.addTorrent}" HorizontalAlignment="Stretch" Click="OnAddTorrentClick" Margin="0,0,0,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T torlink.openSettings}" HorizontalAlignment="Stretch" Click="OnSettingsClick" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="14,12,14,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{loc:T torlink.search}" Padding="20,8" Margin="8,0,0,0" Click="OnSearchClick" />
                    <TextBox x:Name="SearchBox" MinHeight="36" Padding="8,6" VerticalContentAlignment="Center" KeyDown="OnSearchKeyDown"
                             AutomationProperties.Name="{loc:T torlink.searchHint}" />
                </DockPanel>
                <TextBlock Grid.Row="1" Style="{StaticResource HintText}" Text="{loc:T torlink.searchHint}" Margin="2,4,0,0" />
                <TextBlock x:Name="MessageText" Grid.Row="2" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed" />

                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ResultHeader" Grid.Row="0" Margin="10,0,10,2" Visibility="Collapsed" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <StackPanel x:Name="ResultRows" />
                            <TextBlock x:Name="EmptyText" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Dolje: Download Manager -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="0,1,0,0" MaxHeight="280" Padding="12,6,12,8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                    <StackPanel x:Name="TabBar" Orientation="Horizontal" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,4,0,0">
                    <StackPanel>
                        <StackPanel x:Name="DownloadRows" />
                        <TextBlock x:Name="DownloadsEmptyText" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,12,0,6" Text="{loc:T torlink.dl.empty}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
