<Window x:Class="JebaitedPlayer.Views.UpdateHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        Title="{loc:T history.title}"
        Width="660" Height="640" MinWidth="460" MinHeight="380" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <!-- Povijest nadogradnji (UPGRADE 3): lokalna povijest (ugrađena) uvijek, a novije verzije s GitHuba kad je internet dostupan. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="24,18,24,6">
            <TextBlock Text="{loc:T history.title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="InstalledText" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock x:Name="OnlineStatusText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="24,0,24,16">
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource MenuBorderBrush}" Margin="0,0,0,14" />
            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="{loc:T history.allReleases}"
                    VerticalAlignment="Center" Click="OnAllReleasesClick" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T common.close}" Click="OnCloseClick" Margin="0" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="Entries" Margin="24,6,24,16" />
        </ScrollViewer>
    </DockPanel>
</Window>
