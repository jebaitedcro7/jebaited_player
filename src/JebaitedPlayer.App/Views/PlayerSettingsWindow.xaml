<Window x:Class="JebaitedPlayer.Views.PlayerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        xmlns:views="clr-namespace:JebaitedPlayer.Views"
        xmlns:ctl="clr-namespace:JebaitedPlayer.Controls"
        Title="{loc:T settings.title}"
        Width="900" Height="660" MinWidth="700" MinHeight="440" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <!-- Postavke u karticama (UPGRADE 3). Sve se primjenjuje odmah i sprema pri zatvaranju. -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0">
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource MenuBorderBrush}" />
            <!-- Ciklus 3: radna kopija (M2a) i zadane vrijednosti (M2b). -->
            <TextBlock x:Name="SaveStatusText" DockPanel.Dock="Left" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="22,0,0,0"
                       ToolTip="{loc:T settings.savedHint}" />
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T common.close}" Click="OnClose"
                    Margin="6,12,22,12" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{loc:T settings.save}" Click="OnSave"
                    Margin="6,12,0,12" />
            <Button x:Name="DiscardButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.discard}"
                    Click="OnDiscard" Margin="6,12,0,12" />
            <Button x:Name="DefaultsButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.defaults}"
                    Click="OnDefaults" Margin="0,12,0,12" />
        </DockPanel>

        <TabControl x:Name="Tabs" Style="{StaticResource SettingsTabs}">

            <!-- 1. Općenito -->
            <TabItem x:Name="GeneralTab" Style="{StaticResource SettingsTab}" Tag="&#xE713;" Header="{loc:T settings.tabGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="28,20,28,24" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabTitle}" Text="{loc:T settings.tabGeneral}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.generalHint}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.playback}" />
                        <TextBlock Text="{loc:T settings.resumeLabel}" Margin="0,4,0,0" />
                        <RadioButton x:Name="ResumeAsk" GroupName="Resume" Content="{loc:T settings.resumeAsk}" />
                        <RadioButton x:Name="ResumeAuto" GroupName="Resume" Content="{loc:T settings.resumeAuto}" />
                        <RadioButton x:Name="ResumeStart" GroupName="Resume" Content="{loc:T settings.resumeStart}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.resumeHint}" Margin="0,6,0,0" />

                        <TextBlock Text="{loc:T settings.seekStep}" Margin="0,16,0,0" />
                        <Button x:Name="SeekStepButton" Style="{StaticResource ChoiceButton}" Click="OnSeekStepClick" />
                        <TextBlock x:Name="SeekStepHint" Style="{StaticResource HintText}" Margin="0,6,0,0" />

                        <CheckBox x:Name="OpenFullscreenBox" Content="{loc:T settings.openFullscreen}" Margin="0,16,0,0" />
                        <CheckBox x:Name="OnTopBox" Margin="0,8,0,0">
                            <TextBlock Text="{loc:T settings.onTop}" TextWrapping="Wrap" />
                        </CheckBox>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.series}" Margin="0,24,0,2" />
                        <CheckBox x:Name="AutoNextBox" Content="{loc:T settings.autoNext}" />
                        <Grid Margin="0,8,0,0" MaxWidth="440" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T settings.countdown}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Slider x:Name="UpNextSlider" Grid.Column="1" Style="{StaticResource PlayerSlider}" Minimum="5" Maximum="30"
                                    TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=UpNextSlider, StringFormat={}{0:0} s}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.autoNextHint}" />
                        <!-- Naslov je u svom retku: u jednom retku s klizačem je dugi naslov guran vrijednost izvan vidljivog dijela. -->
                        <TextBlock Text="{loc:T settings.upNextLead}" Margin="0,12,0,4" TextWrapping="Wrap" />
                        <Grid MaxWidth="440" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="Auto" MinWidth="110" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="UpNextLeadSlider" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="120"
                                    TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpNextLeadText" Grid.Column="1" Margin="14,0,0,0" FontWeight="SemiBold"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.upNextLeadHint}" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.screenshots}" Margin="0,24,0,2" />
                        <TextBlock x:Name="ShotFolderText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.changeFolder}" Click="OnChooseFolder" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.defaultFolder}" Click="OnDefaultFolder" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.openFolder}" Click="OnOpenFolder" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.screenshotsHint}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.windows}" Margin="0,24,0,2" />
                        <TextBlock x:Name="ShellStatusText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.setDefault}" Click="OnSetDefaultPlayer" />
                            <Button x:Name="UnregisterButton" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.unregister}" Click="OnUnregister" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.setDefaultHint}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.singleInstanceHint}" Margin="0,6,0,0" />

                        <!-- Ciklus 2: automatske kopije (M1a), izvoz i uvoz postavki (M1b) -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.backupSection}" Margin="0,24,0,2" />
                        <TextBlock x:Name="BackupStatusText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.exportSettings}" Click="OnExportSettings" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.importSettings}" Click="OnImportSettings" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.openBackups}" Click="OnOpenBackups" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.transferHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Jezik -->
            <TabItem x:Name="LanguageTab" Style="{StaticResource SettingsTab}" Tag="&#xF2B7;" Header="{loc:T settings.tabLanguage}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="28,20,28,24" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabTitle}" Text="{loc:T settings.tabLanguage}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.languageHint}" Margin="0,0,0,14" />
                        <views:LanguageSelector Width="460" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.languageRemembered}" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.languageSubtitlesHint}" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. Titlovi -->
            <TabItem x:Name="SubtitlesTab" Style="{StaticResource SettingsTab}" Tag="&#xE7F0;" Header="{loc:T settings.tabSubtitles}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="28,20,28,24" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabTitle}" Text="{loc:T settings.tabSubtitles}" />
                        <ContentControl x:Name="SubtitlesHost" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. Zvuk -->
            <TabItem x:Name="AudioTab" Style="{StaticResource SettingsTab}" Tag="&#xE767;" Header="{loc:T settings.tabAudio}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="28,20,28,24" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabTitle}" Text="{loc:T settings.tabAudio}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.volume}" Margin="0,8,0,2" />
                        <Grid Margin="0,6,0,0" Width="420" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="100"
                                    SmallChange="5" LargeChange="10" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=VolumeSlider, StringFormat={}{0:0} %}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.volumeHint}" />
                        <CheckBox x:Name="NormalizeBox" Margin="0,12,0,0">
                            <TextBlock Text="{loc:T settings.normalize}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.normalizeHint}" Margin="28,4,0,0" />

                        <!-- Equalizer (ciklus 1) -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.equalizer}" Margin="0,24,0,2" />
                        <WrapPanel Margin="0,6,0,0">
                            <RadioButton x:Name="EqMoviesRadio" GroupName="EqTarget" Content="{loc:T settings.eqForMovies}" Margin="0,0,20,0" />
                            <RadioButton x:Name="EqMusicRadio" GroupName="EqTarget" Content="{loc:T settings.eqForMusic}" />
                        </WrapPanel>
                        <views:EqualizerPanel x:Name="EqualizerPanel" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.eqHint}" Margin="0,8,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.audioTrack}" Margin="0,24,0,2" />
                        <TextBlock Text="{loc:T settings.audioLanguage}" Margin="0,4,0,0" />
                        <Button x:Name="AudioLanguageButton" Style="{StaticResource ChoiceButton}" Click="OnAudioLanguageClick" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.audioLanguageHint}" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.audioDevice}" Margin="0,24,0,2" />
                        <Button x:Name="AudioDeviceButton" Style="{StaticResource ChoiceButton}" Click="OnAudioDeviceClick" MinWidth="320" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.audioDeviceHint}" Margin="0,6,0,0" />

                        <!-- V4 (ciklus 4): glazba, radio i mini player na zasebnom izlazu, npr. virtualni kabel prema Discordu. -->
                        <TextBlock Text="{loc:T settings.musicAudioDevice}" Margin="0,14,0,0" />
                        <Button x:Name="MusicAudioDeviceButton" Style="{StaticResource ChoiceButton}" Click="OnMusicAudioDeviceClick" MinWidth="320" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.musicAudioDeviceHint}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.audioDelay}" Margin="0,24,0,2" />
                        <Grid Margin="0,6,0,0" Width="520" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="AudioDelaySlider" Style="{StaticResource PlayerSlider}" Minimum="-2000" Maximum="2000"
                                    SmallChange="50" LargeChange="250" TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="AudioDelayText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.reset}"
                                    Click="OnResetAudioDelay" Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.audioDelayHint}" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5. Slika -->
            <TabItem x:Name="VideoTab" Style="{StaticResource SettingsTab}" Tag="&#xE714;" Header="{loc:T settings.tabVideo}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="28,20,28,24" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabTitle}" Text="{loc:T settings.tabVideo}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.quality}" Margin="0,8,0,2" />
                        <RadioButton x:Name="QualityBalanced" GroupName="Quality" Content="{loc:T settings.qualityBalanced}" />
                        <RadioButton x:Name="QualityHigh" GroupName="Quality" Content="{loc:T settings.qualityHigh}" />
                        <RadioButton x:Name="QualityFast" GroupName="Quality" Content="{loc:T settings.qualityFast}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.qualityHint}" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.decoding}" Margin="0,24,0,2" />
                        <CheckBox x:Name="HwdecBox" Content="{loc:T settings.hwdec}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.hwdecHint}" Margin="28,4,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.aspect}" Margin="0,24,0,2" />
                        <Button x:Name="AspectButton" Style="{StaticResource ChoiceButton}" Click="OnAspectClick" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.aspectHint}" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.hdr}" Margin="0,24,0,2" />
                        <CheckBox x:Name="HdrBox">
                            <TextBlock Text="{loc:T settings.hdrPassthrough}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.hdrHint}" Margin="28,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 6. Izgled -->
            <TabItem x:Name="AppearanceTab" Style="{StaticResource SettingsTab}" Tag="&#xE790;" Header="{loc:T settings.appearance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="28,20,28,24" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabTitle}" Text="{loc:T settings.appearance}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.theme}" Margin="0,8,0,2" />
                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="{loc:T settings.themeDark}" />
                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="{loc:T settings.themeLight}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.themeHint}" Margin="0,6,0,0" />

                        <!-- 2.0: boja isticanja (gotove boje ili vlastita); pozadina ostaje tema. -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.accent}" Margin="0,24,0,2" />
                        <WrapPanel x:Name="AccentPanel" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="AccentCustomButton" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.accentCustom}" Click="OnAccentCustom" />
                            <TextBlock x:Name="AccentHexText" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.accentHint}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <!-- N4 (ciklus 5): slika pozadine početnog ekrana. -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.homeBackground}" Margin="0,24,0,2" />
                        <RadioButton x:Name="HomeBgDefault" GroupName="HomeBg" Content="{loc:T settings.homeBackgroundDefault}" />
                        <RadioButton x:Name="HomeBgCustom" GroupName="HomeBg" Content="{loc:T settings.homeBackgroundImage}" />
                        <StackPanel Orientation="Horizontal" Margin="28,8,0,0">
                            <Border Width="160" Height="90" BorderThickness="1" BorderBrush="{DynamicResource MenuBorderBrush}" ClipToBounds="True"
                                    Background="{DynamicResource PanelBackgroundBrush}">
                                <Grid>
                                    <Image x:Name="HomeBgPreview" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border x:Name="HomeBgPreviewDim" Background="{DynamicResource HomeImageDimBrush}" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="HomeBgChooseButton" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.homeBackgroundChoose}"
                                        Click="OnHomeBgChoose" HorizontalAlignment="Left" />
                                <TextBlock x:Name="HomeBgFileText" Style="{StaticResource HintText}" Margin="0,6,0,0" MaxWidth="360"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{loc:T settings.homeBackgroundMode}" Margin="28,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="28,4,0,0">
                            <RadioButton x:Name="HomeBgFill" GroupName="HomeBgMode" Content="{loc:T settings.homeBackgroundFill}" Margin="0,0,18,0" />
                            <RadioButton x:Name="HomeBgFit" GroupName="HomeBgMode" Content="{loc:T settings.homeBackgroundFit}" Margin="0,0,18,0" />
                            <RadioButton x:Name="HomeBgCenter" GroupName="HomeBgMode" Content="{loc:T settings.homeBackgroundCenter}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.homeBackgroundHint}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <!-- N3 (ciklus 6): vrijeme, datum i prognoza na početnom ekranu. -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.homeInfo}" Margin="0,24,0,2" />
                        <CheckBox x:Name="HomeTimeBox" Content="{loc:T settings.homeInfoTime}" />
                        <CheckBox x:Name="HomeDateBox" Content="{loc:T settings.homeInfoDate}" Margin="0,4,0,0" />
                        <CheckBox x:Name="HomeWeatherBox" Content="{loc:T settings.homeInfoWeather}" Margin="0,4,0,0" />
                        <DockPanel Margin="28,8,0,0" MaxWidth="520" HorizontalAlignment="Left">
                            <Button x:Name="WeatherFindButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.weatherFind}" Click="OnWeatherFind" Margin="8,0,0,0" />
                            <TextBox x:Name="WeatherCityBox" MinHeight="32" Padding="6,5" MinWidth="260" VerticalContentAlignment="Center" KeyDown="OnWeatherCityKey" />
                        </DockPanel>
                        <TextBlock x:Name="WeatherCityText" Style="{StaticResource HintText}" Margin="28,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                            <RadioButton x:Name="WeatherCelsius" GroupName="WeatherUnit" Content="{loc:T weather.celsius}" Margin="0,0,18,0" />
                            <RadioButton x:Name="WeatherFahrenheit" GroupName="WeatherUnit" Content="{loc:T weather.fahrenheit}" />
                        </StackPanel>
                        <!-- 2.1.7: font, veličina i mjesto svakog elementa, podaci prognoze, pregled i zadano. -->
                        <TextBlock Text="{loc:T settings.homeLook}" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <StackPanel x:Name="HomeLookPanel" Margin="28,0,0,0" />
                        <TextBlock Text="{loc:T settings.homeDetails}" Margin="28,12,0,0" />
                        <Border x:Name="HomeDetailsHost" Margin="28,0,0,0" />
                        <TextBlock Text="{loc:T settings.homePreview}" Margin="28,12,0,0" />
                        <Border x:Name="HomePreviewHost" Margin="28,4,0,0" HorizontalAlignment="Left" Width="332" Height="172"
                                Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="1" CornerRadius="6" ClipToBounds="True" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.homeLookDefault}" Click="OnHomeLookDefault"
                                Margin="28,10,0,0" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.homeInfoHint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T weather.source}" TextWrapping="Wrap" Margin="0,2,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.controls}" Margin="0,24,0,2" />
                        <TextBlock Text="{loc:T settings.hideControls}" Margin="0,4,0,0" />
                        <Button x:Name="HideControlsButton" Style="{StaticResource ChoiceButton}" Click="OnHideControlsClick" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.hideControlsHint}" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.advanced}" Margin="0,24,0,2" />
                        <CheckBox x:Name="GpuUiBox" Content="{loc:T settings.gpuUi}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.gpuUiHint}" Margin="28,4,0,0" />

                        <!-- 1.4.1: mini player (isto i desnim klikom na mini player) -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T menu.miniPlayer}" Margin="0,24,0,2" />
                        <TextBlock Text="{loc:T mini.menuFont}" Margin="0,4,0,0" />
                        <Button x:Name="MiniFontButton" Style="{StaticResource ChoiceButton}" Click="OnMiniFontClick" MinWidth="240" />
                        <TextBlock Text="{loc:T mini.menuVu}" Margin="0,12,0,0" />
                        <Button x:Name="MiniVuButton" Style="{StaticResource ChoiceButton}" Click="OnMiniVuClick" MinWidth="240" />
                        <CheckBox x:Name="MiniAutoSwitchBox" Margin="0,14,0,0">
                            <TextBlock Text="{loc:T mini.autoSwitch}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.miniHint}" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 7. Prečaci (2.0): svaka radnja do dvije tipke; klik na tipku i pritisak nove kombinacije. -->
            <TabItem x:Name="ShortcutsTab" Style="{StaticResource SettingsTab}" Tag="&#xE765;" Header="{loc:T settings.tabShortcuts}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="28,20,28,4" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabTitle}" Text="{loc:T settings.tabShortcuts}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.shortcutsHint}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ShortcutsStatus" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" MinHeight="18" Margin="0,8,0,0" />
                    </StackPanel>
                    <ScrollViewer x:Name="ShortcutsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="ShortcutsList" Margin="28,0,28,24" MaxWidth="700" HorizontalAlignment="Left" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 8. Nadogradnje -->
            <TabItem x:Name="UpdatesTab" Style="{StaticResource SettingsTab}" Tag="&#xE895;" Header="{loc:T settings.updates}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="28,20,28,24" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabTitle}" Text="{loc:T settings.updates}" />
                        <TextBlock x:Name="VersionText" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <ctl:DownloadProgressBar x:Name="UpdateProgress" Margin="0,10,0,0" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                        <CheckBox x:Name="AutoUpdateBox" Content="{loc:T settings.autoUpdate}" Margin="0,12,0,0" />
                        <WrapPanel x:Name="UpdateButtons" Margin="0,10,0,0">
                            <Button x:Name="CheckUpdateButton" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.checkNow}" Click="OnCheckUpdate" />
                            <Button x:Name="RestartUpdateButton" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.restartUpdate}" Click="OnRestartUpdate" />
                        </WrapPanel>
                        <TextBlock x:Name="UpdatesHintText" Style="{StaticResource HintText}" Text="{loc:T settings.updatesHint}" />
                        <TextBlock x:Name="UpdatesStoreHintText" Style="{StaticResource HintText}" Text="{loc:T settings.updatesHintStore}" Visibility="Collapsed" />

                        <TextBlock x:Name="WhatsNewTitle" Style="{StaticResource SectionHeader}" Margin="0,24,0,2" />
                        <TextBlock x:Name="WhatsNewDate" Style="{StaticResource HintText}" />
                        <StackPanel x:Name="WhatsNewList" Margin="0,6,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.viewHistory}" Click="OnViewHistory" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.githubReleases}" Click="OnGitHubReleases" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.historyHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 8. O aplikaciji -->
            <TabItem x:Name="AboutTab" Style="{StaticResource SettingsTab}" Tag="&#xE946;" Header="{loc:T settings.tabAbout}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="28,20,28,24" MaxWidth="640" HorizontalAlignment="Left">
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="/Assets/logo-ufo.png" Height="84" Margin="0,0,18,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="jebaited_player" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="jebaited_cro" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                <TextBlock x:Name="AboutVersionText" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{loc:T settings.aboutDescription}" TextWrapping="Wrap" Margin="0,16,0,0" />

                        <!-- N1 (ciklus 6): dijagnostika (pristanak, red izvještaja, ručno slanje preko GitHuba). -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.diagnostics}" Margin="0,24,0,2" />
                        <CheckBox x:Name="SendReportsBox" Content="{loc:T settings.sendReports}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.sendReportsHint}" TextWrapping="Wrap" Margin="28,4,0,0" />
                        <TextBlock x:Name="ReportsStatusText" Margin="28,6,0,0" TextWrapping="Wrap" />
                        <Button x:Name="ReportGitHubButton" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.reportGitHub}" Click="OnReportGitHub"
                                HorizontalAlignment="Left" Margin="28,8,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.license}" Margin="0,24,0,2" />
                        <TextBlock Text="{loc:T settings.licenseText}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.licenseButton}" Click="OnLicense" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.sourceCode}" Click="OnSourceCode" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.technologies}" Margin="0,20,0,2" />
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.technologiesHint}" />
                        <StackPanel x:Name="TechnologyList" Margin="0,8,0,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.thirdParty}" Click="OnThirdParty"
                                HorizontalAlignment="Left" Margin="0,10,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.docs}" Margin="0,20,0,2" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.manual}" Click="OnManual" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.viewHistory}" Click="OnViewHistory" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.viewLogs}" Click="OnViewLogs" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.manualHint}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.privacy}" Margin="0,20,0,2" />
                        <TextBlock Text="{loc:T settings.privacyText}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.privacyButton}" Click="OnPrivacy" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.codeSigning}" Click="OnCodeSigning" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
