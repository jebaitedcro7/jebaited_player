<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>jebaited_player</AssemblyName>
    <RootNamespace>JebaitedPlayer</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\jebaited_player.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vlastiti Main (Program.cs): jedna instanca i naredbe prije prozora, pa App.xaml nije ulazna točka. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <InternalsVisibleTo Include="JebaitedPlayer.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Alien logo (UFO dio originalnog assets/logo.png) za početni ekran i odabir jezika. -->
    <Resource Include="..\..\assets\logo-ufo.png" Link="Assets\logo-ufo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Povijest nadogradnji (UPGRADE 3): ugrađena u program, pa radi bez interneta; iz nje nastaju i CHANGELOG*.md. -->
    <EmbeddedResource Include="History\update-history.json" LogicalName="update-history.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Instalacija i nadogradnje preko GitHub Releases (MIT). -->
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- Ciklus 6, V9: službeni ugrađeni YouTube player (IFrame) u vidljivom prozoru. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <!-- V4-B Discord bot: NetCord (MIT, DAVE preko libdave), Concentus (Opus u C#, BSD-3) -->
    <PackageReference Include="NetCord" Version="1.0.0-beta.30" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Repozitorij s izdanjima za nadogradnje (Directory.Build.props). -->
    <AssemblyMetadata Include="UpdateRepositoryUrl" Value="$(UpdateRepositoryUrl)" />
    <!-- Ključ aplikacije za OpenSubtitles: samo u izdanjima (tools/release.ps1 iz secrets/, nikad u gitu). -->
    <AssemblyMetadata Include="OsAppKey" Value="$(JebaitedOsAppKey)" Condition="'$(JebaitedOsAppKey)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JebaitedPlayer.Localization\JebaitedPlayer.Localization.csproj" />
    <ProjectReference Include="..\JebaitedPlayer.Mpv\JebaitedPlayer.Mpv.csproj" />
    <ProjectReference Include="..\JebaitedPlayer.Subtitles\JebaitedPlayer.Subtitles.csproj" />
    <ProjectReference Include="..\JebaitedPlayer.Diagnostics\JebaitedPlayer.Diagnostics.csproj" />
    <ProjectReference Include="..\JebaitedPlayer.Library\JebaitedPlayer.Library.csproj" />
    <ProjectReference Include="..\JebaitedPlayer.Online\JebaitedPlayer.Online.csproj" />
    <ProjectReference Include="..\JebaitedPlayer.Sync\JebaitedPlayer.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tekstovi sučelja (Languages/*.json). -->
    <Using Include="JebaitedPlayer.Localization" />
  </ItemGroup>

  <ItemGroup>
    <!-- libmpv se kopira uz exe; izvor i SHA256 su u third_party/libmpv/SOURCE.md -->
    <None Include="..\..\third_party\libmpv\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- libdave (DAVE E2EE za Discord bota), izgrađen s OpenSSL 3; izvor i SHA256 su u third_party/libdave/SOURCE.md -->
    <None Include="..\..\third_party\libdave\libdave.dll" Link="libdave.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\..\third_party\libdave\libdave.dll')" />
    <!-- Popis komponenti i puni tekstovi licenci koje traže isporuku uz program (OpenSSL Apache-2.0, BSD, MIT) -->
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="licenses\THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\third_party\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
