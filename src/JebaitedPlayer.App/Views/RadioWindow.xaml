<Window x:Class="JebaitedPlayer.Views.RadioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        Title="{loc:T radio.title}" Width="660" Height="580" MinWidth="480" MinHeight="380" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <!-- Ciklus 3, V3: radio postaje iz Radio Browsera (pretraga po nazivu, žanru i državi), favoriti i ručni URL. -->
    <DockPanel Margin="20,16,20,16">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TabTitle}" Text="{loc:T radio.title}" />

        <Grid DockPanel.Dock="Top" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Height="32" ToolTip="{loc:T radio.searchHint}" />
            <Button x:Name="GenreButton" Grid.Column="1" Style="{StaticResource ChoiceButton}" Click="OnGenreClick" MinWidth="120" Margin="8,0,0,0" />
            <Button x:Name="CountryButton" Grid.Column="2" Style="{StaticResource ChoiceButton}" Click="OnCountryClick" MinWidth="130" Margin="8,0,0,0" />
            <Button Grid.Column="3" Style="{StaticResource AccentButton}" Content="{loc:T radio.search}" Click="OnSearch" IsDefault="True" Margin="8,0,0,0" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,6">
            <RadioButton x:Name="ResultsTab" GroupName="RadioView" Content="{loc:T radio.results}" IsChecked="True" Margin="0,0,18,0" />
            <RadioButton x:Name="FavoritesTab" GroupName="RadioView" Content="{loc:T radio.favorites}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{loc:T radio.manualUrl}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T radio.play}" Click="OnPlayUrl" />
            <TextBox x:Name="UrlBox" VerticalContentAlignment="Center" Height="32" Margin="0,0,8,0" />
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />

        <Border BorderThickness="1" BorderBrush="{DynamicResource MenuBorderBrush}" CornerRadius="6" Padding="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="StationList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource ListRowButton}" Tag="{Binding}" Click="OnPlayRow" Padding="10,5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="14" Tag="{Binding}"
                                        Content="{Binding StarGlyph}" Click="OnStarRow" ToolTip="{loc:T radio.favoriteToggle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
