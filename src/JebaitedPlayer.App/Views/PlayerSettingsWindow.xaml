<Window x:Class="JebaitedPlayer.Views.PlayerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        xmlns:views="clr-namespace:JebaitedPlayer.Views"
        Title="{loc:T settings.title}"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="22,0,22,16">
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource MenuBorderBrush}" Margin="0,0,0,14" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T common.close}" Click="OnClose" Margin="0,0,0,6" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="22,8,22,16" Width="440">
                <!-- Jezik -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.language}" />
                <views:LanguageSelector />
                <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.languageHint}" />

                <!-- Izgled -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.appearance}" />
                <DockPanel Margin="0,2,0,0">
                    <ToggleButton x:Name="LightThemeBox" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:T settings.lightTheme}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </DockPanel>
                <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.themeHint}" />

                <!-- Serije -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.series}" />
                <CheckBox x:Name="AutoNextBox" Content="{loc:T settings.autoNext}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:T settings.countdown}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Slider x:Name="UpNextSlider" Grid.Column="1" Style="{StaticResource PlayerSlider}" Minimum="5" Maximum="30"
                            TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=UpNextSlider, StringFormat={}{0:0} s}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Style="{StaticResource HintText}"
                           Text="{loc:T settings.autoNextHint}" />

                <!-- Snimke zaslona -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.screenshots}" />
                <TextBlock x:Name="ShotFolderText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.changeFolder}" Click="OnChooseFolder" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.defaultFolder}" Click="OnDefaultFolder" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.openFolder}" Click="OnOpenFolder" />
                </WrapPanel>
                <TextBlock Style="{StaticResource HintText}" Text="{loc:T settings.screenshotsHint}" />

                <!-- Titlovi -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.subtitles}" />
                <WrapPanel>
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.subtitleSettings}" Click="OnSubtitleSettings" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.onlineGuide}" Click="OnOnlineSetup" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.sources}" Click="OnSources" />
                </WrapPanel>

                <!-- Windows -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.windows}" />
                <TextBlock x:Name="ShellStatusText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.setDefault}" Click="OnSetDefaultPlayer" />
                    <Button x:Name="UnregisterButton" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.unregister}" Click="OnUnregister" />
                </WrapPanel>
                <TextBlock Style="{StaticResource HintText}"
                           Text="{loc:T settings.setDefaultHint}" />

                <!-- Nadogradnje -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.updates}" />
                <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                <CheckBox x:Name="AutoUpdateBox" Content="{loc:T settings.autoUpdate}" Margin="0,8,0,0" />
                <WrapPanel x:Name="UpdateButtons" Margin="0,8,0,0">
                    <Button x:Name="CheckUpdateButton" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.checkNow}" Click="OnCheckUpdate" />
                    <Button x:Name="RestartUpdateButton" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.restartUpdate}" Click="OnRestartUpdate" />
                </WrapPanel>
                <TextBlock Style="{StaticResource HintText}"
                           Text="{loc:T settings.updatesHint}" />

                <!-- Napredno -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T settings.advanced}" />
                <CheckBox x:Name="GpuUiBox" Content="{loc:T settings.gpuUi}" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="{loc:T settings.gpuUiHint}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
