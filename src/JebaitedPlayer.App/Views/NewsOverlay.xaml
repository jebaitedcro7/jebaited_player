<UserControl x:Class="JebaitedPlayer.Views.NewsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
             Visibility="Collapsed" SnapsToDevicePixels="False">

    <!-- Kartica obavijesti (News Card) i strelica prema broju verzije. Prazna površina ne hvata miš (Canvas bez pozadine). -->
    <Canvas x:Name="Layer">
        <Path x:Name="Shaft" StrokeThickness="2.2" StrokeStartLineCap="Round" IsHitTestVisible="False"
              Stroke="{DynamicResource AccentBrush}" />
        <Polygon x:Name="Head" Fill="{DynamicResource AccentBrush}" IsHitTestVisible="False" />
        <Ellipse x:Name="Anchor" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" IsHitTestVisible="False" />

        <Border x:Name="Card" Width="366" Padding="15,13" CornerRadius="13" Cursor="Hand"
                Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1"
                MouseLeftButtonUp="OnCardClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="11" VerticalAlignment="Top" Margin="0,2,13,0"
                        Background="{DynamicResource HomeCardBrush}">
                    <TextBlock x:Name="IconText" FontFamily="{DynamicResource IconFont}" FontSize="22" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,22,0">
                    <Border x:Name="TagBox" HorizontalAlignment="Left" CornerRadius="10" Padding="8,1">
                        <TextBlock x:Name="TagText" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="BodyText" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button x:Name="MoreButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,9,0,0"
                            Padding="12,4" Content="{loc:T news.readMore}" Click="OnMoreClick" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                        Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0"
                        ToolTip="{loc:T news.dismiss}" AutomationProperties.Name="{loc:T news.dismiss}" Click="OnCloseClick" />
            </Grid>
        </Border>
    </Canvas>
</UserControl>
