<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tamna tema (zadana). Svijetla tema (Light.xaml) ima iste ključeve. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#171717" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A3A3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7BD88F" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0B1A0F" />
    <SolidColorBrush x:Key="TrackBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2E4A35" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#55FFFFFF" />

    <!-- Poluprozirna podloga popisa na početnom ekranu (preko svemirske pozadine). -->
    <SolidColorBrush x:Key="HomeCardBrush" Color="#8C0B101B" />

    <!-- Sjaj iza loga na početnom ekranu i u odabiru jezika. -->
    <RadialGradientBrush x:Key="LogoGlowBrush">
        <GradientStop Color="#40B7F5C2" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
