<Window x:Class="JebaitedPlayer.Views.SubtitleSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        Title="{loc:T sources.title}"
        Width="580" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <!-- Gumbi su uvijek vidljivi; ostatak se pomiče ako prozor ne stane na zaslon (npr. 1366×768). -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="22,0,22,16">
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource MenuBorderBrush}" Margin="0,0,0,14" />
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="18,8" Click="OnSaveClick" Margin="8,0,0,0">
                <TextBlock Text="{loc:T common.save}" FontWeight="SemiBold" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T common.cancel}" Click="OnCancelClick" Margin="0" />
        </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="22,8,22,16">
        <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                   Text="{loc:T sources.securityHint}" />

        <!-- Automatsko traženje i spremanje uz video: Postavke → Titlovi (UPGRADE 3). -->

        <!-- OpenSubtitles -->
        <DockPanel Margin="0,18,0,2">
            <CheckBox x:Name="OsEnabled" DockPanel.Dock="Right" Content="{loc:T sources.enabled}" Margin="0" VerticalAlignment="Center" />
            <TextBlock Text="OpenSubtitles.com" FontSize="14" FontWeight="SemiBold" />
        </DockPanel>
        <TextBlock Style="{StaticResource HintText}"
                   Text="{loc:T sources.osHint}" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:T sources.apiKey}" VerticalAlignment="Center" />
            <PasswordBox x:Name="OsKey" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Text="{loc:T sources.username}" VerticalAlignment="Center" />
            <TextBox x:Name="OsUser" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Text="{loc:T sources.password}" VerticalAlignment="Center" />
            <PasswordBox x:Name="OsPassword" Grid.Row="2" Grid.Column="1" />
        </Grid>
        <TextBlock x:Name="OsKeyHint" Style="{StaticResource HintText}" Text="" />
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="{loc:T sources.test}" Click="OnTestOpenSubtitles" Margin="0,0,10,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{loc:T sources.whereKey}" VerticalAlignment="Center"
                    Tag="https://www.opensubtitles.com/en/consumers" Click="OnLinkClick" />
            <TextBlock x:Name="OsStatus" Style="{StaticResource HintText}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- SubDL -->
        <DockPanel Margin="0,20,0,2">
            <CheckBox x:Name="SubDlEnabled" DockPanel.Dock="Right" Content="{loc:T sources.enabled}" Margin="0" VerticalAlignment="Center" />
            <TextBlock Text="SubDL.com" FontSize="14" FontWeight="SemiBold" />
        </DockPanel>
        <TextBlock Style="{StaticResource HintText}" Text="{loc:T sources.subdlHint}" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:T sources.apiKey}" VerticalAlignment="Center" />
            <PasswordBox x:Name="SubDlKey" Grid.Column="1" />
        </Grid>
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="{loc:T sources.test}" Click="OnTestSubDl" Margin="0,0,10,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{loc:T sources.whereKey}" VerticalAlignment="Center"
                    Tag="https://subdl.com/panel/api" Click="OnLinkClick" />
            <TextBlock x:Name="SubDlStatus" Style="{StaticResource HintText}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Titlovi.com -->
        <DockPanel Margin="0,20,0,2">
            <CheckBox x:Name="TitloviEnabled" DockPanel.Dock="Right" Content="{loc:T sources.enabled}" Margin="0" VerticalAlignment="Center" />
            <TextBlock Text="Titlovi.com" FontSize="14" FontWeight="SemiBold" />
        </DockPanel>
        <TextBlock Style="{StaticResource HintText}"
                   Text="{loc:T sources.titloviHint}" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:T sources.username}" VerticalAlignment="Center" />
            <TextBox x:Name="TitloviUser" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Text="{loc:T sources.password}" VerticalAlignment="Center" />
            <PasswordBox x:Name="TitloviPassword" Grid.Row="1" Grid.Column="1" />
        </Grid>
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="{loc:T sources.test}" Click="OnTestTitlovi" Margin="0,0,10,0" />
            <TextBlock x:Name="TitloviStatus" Style="{StaticResource HintText}" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Style="{StaticResource HintText}" Margin="0,16,0,0"
                   Text="{loc:T sources.podnapisiHint}" />
    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
