<UserControl x:Class="JebaitedPlayer.Views.SubtitleSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure">

    <!-- Postavke titlova (kartica "Titlovi"): jezici i prioritet, automatika, izvori, kodiranje, izgled i sinkronizacija.
         Sve se primjenjuje odmah. -->
    <StackPanel>
        <!-- Jezici -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T subSettings.languages}" Margin="0,8,0,2" />
        <TextBlock Style="{StaticResource HintText}" Text="{loc:T subSettings.languagesHint}" />
        <Grid Margin="0,10,0,0" Width="460" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="LanguageList" MinHeight="120" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:T subSettings.up}" Click="OnMoveUp" Margin="0,0,0,6" />
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:T subSettings.down}" Click="OnMoveDown" Margin="0,0,0,6" />
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:T subSettings.remove}" Click="OnRemove" Margin="0,0,0,6" />
                <Button x:Name="AddLanguageButton" Style="{StaticResource SecondaryButton}" Content="{loc:T subSettings.addLanguage}" Click="OnAddLanguage" Margin="0" />
            </StackPanel>
        </Grid>

        <!-- Automatika -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T sources.automatic}" Margin="0,24,0,2" />
        <CheckBox x:Name="AutoLoadBox" Content="{loc:T subSettings.autoLoad}" />
        <CheckBox x:Name="AutoSearchBox" Content="{loc:T sources.autoSearch}" />
        <CheckBox x:Name="SaveNextBox" Content="{loc:T sources.saveNext}" />

        <!-- Izvori na internetu -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T subSettings.sources}" Margin="0,24,0,2" />
        <TextBlock Style="{StaticResource HintText}" Text="{loc:T subSettings.sourcesHint}" />
        <WrapPanel Margin="0,8,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.sources}" Click="OnSources" />
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T settings.onlineGuide}" Click="OnOnlineSetup" />
        </WrapPanel>

        <!-- Kodiranje -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T subSettings.encoding}" Margin="0,24,0,2" />
        <Button x:Name="EncodingButton" Style="{StaticResource ChoiceButton}" Click="OnEncodingClick" MinWidth="320" />
        <TextBlock Style="{StaticResource HintText}" Text="{loc:T subSettings.encodingHint}" Margin="0,6,0,0" />

        <!-- Izgled -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T subSettings.style}" Margin="0,24,0,2" />
        <TextBlock Style="{StaticResource HintText}" Text="{loc:T subSettings.styleHint}" />

        <Grid Margin="0,12,0,0" Width="460" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{loc:T subSettings.font}" VerticalAlignment="Center" Margin="0,0,12,8" />
            <Button x:Name="FontButton" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ChoiceButton}"
                    Click="OnChooseFont" Margin="0,0,0,8" MinWidth="0" HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="1" Text="{loc:T subSettings.size}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider x:Name="SizeSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource PlayerSlider}" Minimum="24" Maximum="80"
                    VerticalAlignment="Center" Margin="0,5" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=SizeSlider, StringFormat=0}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="2" Text="{loc:T subSettings.outline}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider x:Name="OutlineSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="5"
                    VerticalAlignment="Center" Margin="0,5" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=OutlineSlider, StringFormat=0.0}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Text="{loc:T subSettings.position}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider x:Name="PositionSlider" Grid.Row="3" Grid.Column="1" Style="{StaticResource PlayerSlider}" Minimum="50" Maximum="100"
                    VerticalAlignment="Center" Margin="0,5" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=PositionSlider, StringFormat=0}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="4" Text="{loc:T subSettings.color}" VerticalAlignment="Center" Margin="0,8,12,0" />
            <StackPanel x:Name="ColorPanel" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0" />
        </Grid>

        <CheckBox x:Name="BoldBox" Content="{loc:T subSettings.bold}" Margin="0,12,0,0" />
        <CheckBox x:Name="BackgroundBox" Content="{loc:T subSettings.background}" />
        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T subSettings.resetStyle}" Click="OnResetStyle"
                HorizontalAlignment="Left" Margin="0,12,0,0" />

        <!-- Sinkronizacija -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T subSettings.sync}" Margin="0,24,0,2" />
        <CheckBox x:Name="AutoSyncBox" Content="{loc:T subSettings.autoSync}" />
        <TextBlock Style="{StaticResource HintText}" Text="{loc:T subSettings.syncHint}" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
