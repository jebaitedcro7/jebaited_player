<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.6</Version>
    <InformationalVersion>2.0.6</InformationalVersion>
    <Product>jebaited_player</Product>
    <!-- Izdanja i nadogradnje (Velopack GitHubSource). -->
    <UpdateRepositoryUrl>https://github.com/jebaitedcro7/jebaited_player</UpdateRepositoryUrl>
    <Company>jebaited_player</Company>
    <Copyright>jebaited_player</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
