<Window x:Class="JebaitedPlayer.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        xmlns:views="clr-namespace:JebaitedPlayer.Views"
        Title="jebaited_player mini" WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="True" AllowDrop="True" Icon="/Assets/logo-ufo.png"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="12" UseLayoutRounding="True">

    <!-- Mini Music Player (ciklus 2, V1): puni izgled = dizajn 1 (Klasični Winamp), uska traka = dizajn 3.
         Cijeli sadržaj se skalira (ručka dolje desno, Ctrl + kotačić, Ctrl + / −). LCD je uvijek taman. -->
    <Window.Resources>
        <SolidColorBrush x:Key="LcdBack" Color="#0B100C" />
        <SolidColorBrush x:Key="LcdBorder" Color="#2A4A32" />
        <SolidColorBrush x:Key="LcdText" Color="#7BD88F" />
        <SolidColorBrush x:Key="LcdTrack" Color="#17291C" />
        <Style x:Key="Lcd" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LcdBack}" />
            <Setter Property="BorderBrush" Value="{StaticResource LcdBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="MiniButton" TargetType="ButtonBase">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{DynamicResource MenuBorderBrush}">
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>

            <!-- Dizajn 1: Klasični Winamp -->
            <StackPanel x:Name="FullView" Width="460">
                <DockPanel Height="24" Margin="8,3,3,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource MiniIcon}" Content="&#xE73F;" ToolTip="{loc:T mini.compact}" Click="OnCompact" />
                        <Button Style="{StaticResource MiniIcon}" Content="&#xE8A7;" ToolTip="{loc:T mini.fullPlayer}" Click="OnFullPlayer" />
                        <Button Style="{StaticResource MiniIcon}" Content="&#xE8BB;" ToolTip="{loc:T mini.close}" Click="OnClosePlayer" />
                    </StackPanel>
                    <Image Source="/Assets/logo-ufo.png" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="jebaited_cro · mini" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </DockPanel>

                <Grid Margin="8,4,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Lcd}" Padding="8,3,8,5" Cursor="Hand" ToolTip="{loc:T mini.timeHint}"
                            MouseLeftButtonDown="OnTimeClick">
                        <StackPanel>
                            <TextBlock x:Name="TimeText" Text="00:00" FontFamily="Consolas" FontSize="26" Foreground="{StaticResource LcdText}" />
                            <Grid Margin="0,2,0,0" Height="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="VuLabels" VerticalAlignment="Center">
                                    <TextBlock Text="L" FontSize="8" FontFamily="Consolas" Height="8" Foreground="{StaticResource LcdBorder}" />
                                    <TextBlock Text="R" FontSize="8" FontFamily="Consolas" Height="8" Foreground="{StaticResource LcdBorder}" />
                                </StackPanel>
                                <views:VuMeterView x:Name="Vu" Grid.Column="1" Height="14" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Border Style="{StaticResource Lcd}" Height="26" Padding="8,0">
                            <Canvas x:Name="MarqueeBox" ClipToBounds="True">
                                <TextBlock x:Name="MarqueeText" FontFamily="Consolas" FontSize="13" Canvas.Top="4" Foreground="{StaticResource LcdText}">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </Border>
                        <DockPanel Margin="0,9,0,0">
                            <Border DockPanel.Dock="Left" Background="#1F3324" CornerRadius="8" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:T mini.sourceLocal}" FontSize="10" Foreground="{StaticResource LcdText}" />
                            </Border>
                            <TextBlock x:Name="RemainingText" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Slider x:Name="SeekSlider" Style="{StaticResource PlayerSlider}" Margin="8,0,4,0" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <DockPanel Margin="8,7,8,8">
                    <ToggleButton x:Name="PlaylistToggle" DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Width="36" Margin="0"
                                  FontFamily="Consolas" FontSize="12" Content="PL" ToolTip="{loc:T mini.playlist}" Click="OnPanelsChanged" />
                    <ToggleButton x:Name="EqToggle" DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Width="36"
                                  FontFamily="Consolas" FontSize="12" Content="EQ" ToolTip="{loc:T mini.equalizer}" Click="OnPanelsChanged" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MiniButton}" Content="&#xE892;" ToolTip="{loc:T mini.previous}" Click="OnPrevious" />
                        <Button Style="{StaticResource MiniButton}" Content="&#xE768;" ToolTip="{loc:T mini.play}" Click="OnPlay" />
                        <Button Style="{StaticResource MiniButton}" Content="&#xE769;" ToolTip="{loc:T mini.pause}" Click="OnPause" />
                        <Button Style="{StaticResource MiniButton}" Content="&#xE71A;" ToolTip="{loc:T mini.stop}" Click="OnStop" />
                        <Button Style="{StaticResource MiniButton}" Content="&#xE893;" ToolTip="{loc:T mini.next}" Click="OnNext" />
                        <Button Style="{StaticResource MiniButton}" Content="&#xE838;" ToolTip="{loc:T mini.open}" Click="OnOpen" />
                        <Button x:Name="MuteButton" Style="{StaticResource MiniIcon}" Content="&#xE767;" Margin="6,0,0,0" ToolTip="{loc:T mini.mute}" Click="OnMute" />
                        <Slider x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}" Width="78" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <Border x:Name="EqHost" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuBorderBrush}" Padding="10,6,10,8">
                    <StackPanel>
                        <TextBlock x:Name="EqTitle" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                        <views:EqualizerPanel x:Name="Equalizer" />
                    </StackPanel>
                </Border>

                <Border x:Name="PlaylistHost" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuBorderBrush}" Padding="4,4,4,14">
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl x:Name="PlaylistItems" ItemsSource="{Binding Playlist}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ListRowButton}" CommandParameter="{Binding}" Padding="8,3"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Dizajn 3: uska traka -->
            <Grid x:Name="CompactView" Width="560" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="4" />
                </Grid.RowDefinitions>
                <DockPanel Margin="8,0,14,0">
                    <Image DockPanel.Dock="Left" Source="/Assets/logo-ufo.png" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource MiniButton}" Width="28" Height="26" Content="&#xE892;" ToolTip="{loc:T mini.previous}" Click="OnPrevious" />
                    <Button x:Name="CompactPlayPause" DockPanel.Dock="Left" Style="{StaticResource MiniButton}" Width="28" Height="26" Content="&#xE768;"
                            ToolTip="{loc:T mini.play}" Click="OnPlayPause" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource MiniButton}" Width="28" Height="26" Content="&#xE893;" ToolTip="{loc:T mini.next}" Click="OnNext" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource MiniIcon}" Content="&#xE8BB;" ToolTip="{loc:T mini.close}" Click="OnClosePlayer" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource MiniIcon}" Content="&#xE740;" ToolTip="{loc:T mini.expand}" Click="OnExpand" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource MiniIcon}" FontFamily="Consolas" FontSize="11" Content="EQ" ToolTip="{loc:T mini.equalizer}" Click="OnCompactEqualizer" />
                    <Button x:Name="CompactMute" DockPanel.Dock="Right" Style="{StaticResource MiniIcon}" Content="&#xE767;" ToolTip="{loc:T mini.mute}" Click="OnMute" />
                    <TextBlock x:Name="CompactTime" DockPanel.Dock="Right" Margin="8,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Canvas x:Name="CompactMarqueeBox" ClipToBounds="True" Margin="6,0,0,0" Height="20">
                        <TextBlock x:Name="CompactMarqueeText" FontSize="13" Canvas.Top="1">
                            <TextBlock.RenderTransform>
                                <TranslateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </DockPanel>
                <ProgressBar x:Name="CompactProgress" Grid.Row="1" Style="{StaticResource ThinProgress}" Height="2" Margin="8,0,14,2" />
            </Grid>

            <!-- Ručno povećavanje i smanjenje -->
            <Thumb x:Name="ResizeGrip" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                   ToolTip="{loc:T mini.resize}" DragStarted="OnGripStarted" DragDelta="OnGripDelta" DragCompleted="OnGripCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M11,3 L3,11 M11,7 L7,11" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
