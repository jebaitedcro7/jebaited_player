<Window x:Class="JebaitedPlayer.Views.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        Title="{loc:T settings.unsavedTitle}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <!-- M3b: zatvaranje postavki s nespremljenim promjenama. Enter = Spremi, Esc ili × = Odustani (prozor ostaje). -->
    <Grid>
        <StackPanel Margin="24,20,24,18">
            <TextBlock Text="{loc:T settings.unsavedQuestion}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{loc:T settings.unsavedHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="SaveChoice" Style="{StaticResource AccentButton}" Content="{loc:T settings.save}" IsDefault="True"
                        Click="OnSave" Margin="0,0,6,0" />
                <Button x:Name="DiscardChoice" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.discard}"
                        Click="OnDiscard" Margin="0,0,6,0" />
                <Button x:Name="CancelChoice" Style="{StaticResource SecondaryButton}" Content="{loc:T common.cancel}" IsCancel="True"
                        Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
