<Window x:Class="JebaitedPlayer.Views.DiscordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        Title="{loc:T discord.title}" Width="640" Height="620" MinWidth="500" MinHeight="460" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <!-- V4-B: vlastiti bot korisnika šalje zvuk playera (samo lokalna glazba i radio) u glasovni kanal na Discordu. -->
    <Grid>
        <DockPanel Margin="20,16,20,14">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TabTitle}" Text="{loc:T discord.title}" />

            <!-- 1) Postavljanje: svaki korisnik koristi svog bota i upisuje njegov token (sprema se kriptiran). -->
            <StackPanel x:Name="SetupPanel" DockPanel.Dock="Top" Margin="0,4,0,0">
                <TextBlock Text="{loc:T discord.setupTitle}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource HintText}" Text="{loc:T discord.setupSteps}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <Button Style="{StaticResource LinkButton}" Content="{loc:T discord.openPortal}" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Click="OnOpenPortal" />
                <TextBlock Text="{loc:T discord.token}" Margin="0,10,0,4" />
                <DockPanel>
                    <Button x:Name="SaveTokenButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{loc:T discord.saveToken}"
                            Click="OnSaveToken" Margin="8,0,0,0" />
                    <PasswordBox x:Name="TokenBox" MinHeight="32" Padding="6,5" VerticalContentAlignment="Center" KeyDown="OnTokenKey" />
                </DockPanel>
                <TextBlock Style="{StaticResource HintText}" Text="{loc:T discord.tokenHint}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>

            <!-- 2) Bot -->
            <DockPanel x:Name="BotPanel" DockPanel.Dock="Top" Margin="0,4,0,0">
                <Button x:Name="ConnectButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{loc:T discord.connect}" Click="OnConnect" />
                <Button x:Name="DisconnectButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T discord.disconnect}"
                        Click="OnDisconnect" />
                <Button x:Name="ChangeTokenButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{loc:T discord.changeToken}"
                        Click="OnChangeToken" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock x:Name="BotText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>

            <!-- Napomena i stanje (dolje) -->
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Text="{loc:T discord.note}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

            <!-- 2.1.12: glasnoća na Discordu (prati player ili vlastita). -->
            <StackPanel x:Name="VolumePanel" DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <CheckBox x:Name="FollowVolumeBox" Content="{loc:T discord.followVolume}" Click="OnVolumeMode" />
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="{loc:T discord.volume}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                            VerticalAlignment="Center" ValueChanged="OnDiscordVolume" />
                </DockPanel>
            </StackPanel>

            <!-- 3) Glasovni kanal -->
            <Border x:Name="ChannelPanel" DockPanel.Dock="Top" Margin="0,12,0,0" Padding="14" CornerRadius="8" VerticalAlignment="Top"
                    Background="{DynamicResource HomeCardBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="ChannelText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SendingText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <ProgressBar x:Name="LevelBar" Height="6" Maximum="32767" Margin="0,8,0,0" BorderThickness="0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource PanelBackgroundBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="JoinMineButton" Style="{StaticResource AccentButton}" Content="{loc:T discord.joinMine}" Click="OnJoinMine" />
                        <Button x:Name="LeaveButton" Style="{StaticResource SecondaryButton}" Content="{loc:T discord.leave}" Click="OnLeave" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{loc:T discord.otherChannel}" Margin="0,14,0,4" />
                    <Border BorderThickness="1" BorderBrush="{DynamicResource MenuBorderBrush}" CornerRadius="6" Padding="2" MaxHeight="168">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl x:Name="ChannelList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ListRowButton}" Tag="{Binding}" Click="OnJoinChannel" Padding="8,5"
                                                ToolTip="{loc:T discord.join}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ChannelName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding GuildName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="InviteButton" Style="{StaticResource LinkButton}" Content="{loc:T discord.invite}" HorizontalAlignment="Left"
                            Click="OnInvite" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>
