<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JebaitedPlayer.Sync</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebRTC detektor govora (MIT), nativni WebRtcVad.dll; odobreno u M5. -->
    <PackageReference Include="WebRtcVadSharp" Version="1.3.2" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Paketov .targets ne prelazi na projekte koji referenciraju ovaj, pa DLL kopiramo sami (dolazi i u aplikaciju i u testove). -->
    <None Include="$(PkgWebRtcVadSharp)\build\win-x64\native\WebRtcVad.dll" Link="WebRtcVad.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JebaitedPlayer.Sync.Tests" />
  </ItemGroup>

</Project>
