<Window x:Class="JebaitedPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        xmlns:controls="clr-namespace:JebaitedPlayer.Controls"
        xmlns:views="clr-namespace:JebaitedPlayer.Views"
        Title="jebaited_player"
        Width="1280" Height="760" MinWidth="520" MinHeight="320"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}"
        Focusable="True" AllowDrop="True" UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Područje videa (preko njega leže prozori s kontrolama i karticama). -->
        <Grid x:Name="VideoArea">
            <!-- Video (mpv crta ovdje). Skriven dok nema medija. -->
            <controls:VideoHost x:Name="Video" Visibility="Hidden" />

            <!-- Samo zvuk (MP3, FLAC…). -->
            <Grid x:Name="AudioPanel" Visibility="Collapsed" Background="{DynamicResource PanelBackgroundBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,24,24,140">
                    <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource IconFont}" FontSize="72"
                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding Title}" FontSize="20" Margin="0,18,0,0" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="640" />
                    <views:LiveBadge x:Name="AudioLive" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <!-- Početni ekran. -->
            <Grid x:Name="WelcomePanel" Background="{DynamicResource PanelBackgroundBrush}" SizeChanged="OnWelcomeSizeChanged" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Diskretna svemirska pozadina (crta se jednom, bez animacija). -->
                <controls:SpaceBackground x:Name="HomeSpace" Grid.RowSpan="2" />

                <!-- N4 (ciklus 5): vlastita slika umjesto svemira i blago zatamnjenje, da kartice ostanu čitljive. -->
                <Image x:Name="HomeBackgroundImage" Grid.RowSpan="2" Visibility="Collapsed" Stretch="UniformToFill"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Border x:Name="HomeBackgroundDim" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource HomeImageDimBrush}"
                        IsHitTestVisible="False" />

                <!-- N3 (ciklus 6): vrijeme, datum i prognoza gore lijevo (nenametljivo, ne prima klikove). -->
                <controls:HomeInfoLayer x:Name="HomeLayer" Panel.ZIndex="1" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,20,24,16">
                        <!-- Alien logo (glavni element) s blagim sjajem i ime ispod njega. -->
                        <Grid x:Name="LogoBlock" HorizontalAlignment="Center" Width="300" Height="200" IsHitTestVisible="False">
                            <Ellipse Fill="{DynamicResource LogoGlowBrush}" />
                            <Image x:Name="LogoImage" Source="/Assets/logo-ufo.png" Height="150" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <TextBlock x:Name="AuthorName" Text="jebaited_cro" FontSize="30" FontFamily="Segoe UI Variable Display Light, Segoe UI Light"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock x:Name="ProductName" Text="jebaited_player" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{loc:T home.dropHint}" FontSize="15" Margin="0,18,0,0" MaxWidth="560"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />

                        <StackPanel x:Name="HomeOpenButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                            <Button Style="{StaticResource AccentButton}" Click="OnOpenClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{DynamicResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T home.openFile}" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Click="OnOpenFolderClick" Margin="10,0,0,0" Padding="18,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="{DynamicResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T home.openFolder}" Margin="10,0,0,0" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Dok nijedan izvor titlova nema korisnikov račun ili ključ. -->
                        <Button x:Name="OnlineSetupButton" Style="{StaticResource LinkButton}" Click="OnOnlineSetupClick"
                                HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"
                                Content="{loc:T home.onlineSetup}" />

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Margin="0,18,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,18,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Nastavi gledati i Omiljeno: jedno uz drugo kad stane, inače jedno ispod drugog. -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0">
                        <!-- Nastavi gledati -->
                        <Border Width="520" Margin="14,12,14,0" VerticalAlignment="Top" Background="{DynamicResource HomeCardBrush}"
                                CornerRadius="10" Padding="6,10,6,6"
                                Visibility="{Binding Library.HasRecent, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:T home.continueWatching}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Library.Recent}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource ListRowButton}" CommandParameter="{Binding}"
                                                    Tag="{Binding DataContext.Library, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.Library.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <!-- N2: desni klik → Dodaj u Sljedeće za gledanje. -->
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{loc:T menu.addWatchNext}" CommandParameter="{Binding}"
                                                                  Command="{Binding PlacementTarget.Tag.AddRecentToWatchNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock x:Name="WatchedIcon" FontFamily="{DynamicResource IconFont}" Text="&#xE73E;" FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                                                                   Visibility="Collapsed" />
                                                        <TextBlock x:Name="DetailText" Text="{Binding Detail}" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress}" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                                                    Width="32" Height="32" VerticalAlignment="Center" ToolTip="{loc:T home.removeRecent}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Library.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                        <!-- Ciklus 1 (M6b): pogledano = kvačica, zeleni natpis i puna zelena traka. -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Watched}" Value="True">
                                                <Setter TargetName="WatchedIcon" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="DetailText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>

                        <!-- N2 (ciklus 5): Sljedeće za gledanje (automatski sljedeća epizoda i ručno dodano; ▲ ▼ redoslijed, × ukloni). -->
                        <Border x:Name="WatchNextCard" Width="520" Margin="14,12,14,0" VerticalAlignment="Top" Background="{DynamicResource HomeCardBrush}"
                                CornerRadius="10" Padding="6,10,6,6"
                                Visibility="{Binding Library.HasWatchNext, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:T home.watchNext}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,6" />
                            <ItemsControl x:Name="WatchNextList" ItemsSource="{Binding Library.WatchNext}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="OpenButton" Style="{StaticResource ListRowButton}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Library.OpenWatchNextCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <DockPanel>
                                                    <TextBlock x:Name="KindIcon" DockPanel.Dock="Left" Text="&#xE768;" FontFamily="{DynamicResource IconFont}"
                                                               FontSize="14" Margin="0,3,12,0" VerticalAlignment="Top"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                            <Button x:Name="UpButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="11"
                                                    Width="28" Height="32" VerticalAlignment="Center" ToolTip="{loc:T home.watchNextUp}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Library.MoveWatchNextUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button x:Name="DownButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="11"
                                                    Width="28" Height="32" VerticalAlignment="Center" ToolTip="{loc:T home.watchNextDown}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Library.MoveWatchNextDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button x:Name="RemoveButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                                                    Width="32" Height="32" VerticalAlignment="Center" ToolTip="{loc:T home.watchNextRemove}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Library.RemoveWatchNextCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAuto}" Value="False">
                                                <Setter TargetName="KindIcon" Property="Text" Value="&#xE710;" />
                                                <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                <Setter TargetName="UpButton" Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                <Setter TargetName="DownButton" Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>

                        <!-- Omiljeno (M6) -->
                        <Border Width="520" Margin="14,12,14,0" VerticalAlignment="Top" Background="{DynamicResource HomeCardBrush}"
                                CornerRadius="10" Padding="6,10,6,6"
                                Visibility="{Binding Library.HasFavorites, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:T home.favorites}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Library.Favorites}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource ListRowButton}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Library.OpenFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}"
                                                               FontSize="16" Margin="0,2,12,0" VerticalAlignment="Top"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                                                    Width="32" Height="32" VerticalAlignment="Center" ToolTip="{loc:T home.removeFavorite}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Library.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>
                        </WrapPanel>

                        <Button Style="{StaticResource LinkButton}" Content="{loc:T home.shortcuts}" HorizontalAlignment="Center"
                                Margin="0,22,0,0" Click="OnToggleShortcutsClick" />

                        <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="0,22,0,0" HorizontalAlignment="Center"
                                      Grid.IsSharedSizeScope="True" Focusable="False"
                                      Visibility="{Binding ShowWelcomeShortcuts, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Keys}" FontSize="13" Margin="0,0,24,0" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Donja traka: postavke i tema lijevo (zaseban red, pa popisi ne prelaze preko nje), verzija desno. -->
                <StackPanel Grid.Row="1">
                <!-- 2.1.7: kontrole reprodukcije na početnom ekranu (isto stanje kao player i mini player). -->
                <Border x:Name="HomePlaybackBar" Visibility="Collapsed" MaxWidth="760" Margin="14,0,14,8" Padding="14,10"
                        Background="{DynamicResource HomeCardBrush}" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Margin="0,0,14,0" VerticalAlignment="Center">
                            <!-- 2.1.12: mala sličica omota (samo kad pjesma ima omot). -->
                            <Border x:Name="HomeCoverBox" DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,12,0" CornerRadius="6"
                                    ClipToBounds="True" Visibility="Collapsed" VerticalAlignment="Center">
                                <Image x:Name="HomeCoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="HomeSourceText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" />
                                    <views:LiveBadge x:Name="HomeLive" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="HomeTrackText" FontSize="15" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HomeTimeInfo" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="HomePrevButton" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="{loc:T mini.previous}" Click="OnHomePrevious" />
                            <Button x:Name="HomePlayPauseButton" Style="{StaticResource IconButton}" FontSize="20" Content="&#xE768;" ToolTip="{loc:T controls.playPause}" Click="OnHomePlayPause" />
                            <Button x:Name="HomeNextButton" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="{loc:T mini.next}" Click="OnHomeNext" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="{loc:T home.showPlayer}" Click="OnHomeShowPlayer" />
                        </StackPanel>
                        <StackPanel x:Name="HomeVolumeArea" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Background="Transparent">
                            <Button Style="{StaticResource IconButton}" Content="{Binding VolumeGlyph}" Command="{Binding MuteCommand}" ToolTip="{loc:T controls.mute}" />
                            <Slider x:Name="HomeVolumeSlider" Style="{StaticResource PlayerSlider}" Width="90" Margin="4,0,0,0" VerticalAlignment="Center"
                                    Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Value="{Binding Volume, Mode=TwoWay}"
                                    ToolTip="{loc:T controls.volume}" />
                            <TextBlock Text="{Binding VolumeText}" Margin="8,0,0,0" MinWidth="36" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <DockPanel x:Name="HomeBottomRow" Margin="8,0,14,8" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="17"
                            ToolTip="{loc:T home.settingsTooltip}" AutomationProperties.Name="{loc:T home.settingsTooltip}"
                            Click="OnHomeSettingsClick" />
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                Background="Transparent" ToolTip="{loc:T home.themeTooltip}">
                        <TextBlock Text="&#xE708;" FontFamily="{DynamicResource IconFont}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ToggleButton x:Name="HomeThemeSwitch" Style="{StaticResource SwitchToggle}" Margin="8,0" VerticalAlignment="Center"
                                      AutomationProperties.Name="{loc:T home.themeTooltip}" />
                        <TextBlock Text="&#xE706;" FontFamily="{DynamicResource IconFont}" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <!-- Obavijesti: tipka sa zvoncem i brojem nepročitanih; klik otvara popis (isti kao u Postavke → Obavijesti). -->
                    <Button x:Name="HomeNewsButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Margin="14,0,0,0" Padding="10,3"
                            VerticalAlignment="Center" Click="OnHomeNewsClick" ToolTip="{loc:T news.buttonTooltip}"
                            AutomationProperties.Name="{loc:T news.button}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA8F;" FontFamily="{DynamicResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T news.button}" Margin="7,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                            <Border x:Name="HomeNewsBadge" Margin="8,0,0,0" MinWidth="18" Height="18" CornerRadius="9" Visibility="Collapsed"
                                    Background="{DynamicResource AccentBrush}">
                                <TextBlock x:Name="HomeNewsBadgeText" FontSize="11" FontWeight="Bold" Margin="5,0" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Popup x:Name="HomeNewsPopup" PlacementTarget="{Binding ElementName=HomeNewsButton}" Placement="Top" VerticalOffset="-6"
                           StaysOpen="False">
                        <Border Width="400" Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="8,4,8,4">
                                    <TextBlock Text="{loc:T news.title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource LinkButton}" Content="{loc:T news.openAll}" HorizontalAlignment="Right" FontSize="12"
                                            Click="OnHomeNewsAllClick" />
                                </Grid>
                                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ContentControl x:Name="HomeNewsListHost" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                    <!-- Broj verzije: klik otvara povijest nadogradnji (UPGRADE 3). -->
                    <Button x:Name="VersionButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding VersionText}"
                            FontSize="11" VerticalAlignment="Center" Click="OnVersionClick"
                            ToolTip="{loc:T history.versionTooltip}" AutomationProperties.Name="{loc:T history.versionTooltip}" />
                </DockPanel>
                </StackPanel>

                <!-- Kartica obavijesti sa strelicom do broja verzije (iznad svega na početnom ekranu). -->
                <views:NewsOverlay x:Name="HomeNews" Grid.RowSpan="2" Panel.ZIndex="5" />
            </Grid>
        </Grid>

        <!-- Popis epizoda (desno; video se suzi, pa se ništa ne preklapa). -->
        <Border x:Name="PlaylistPanel" Grid.Column="1" Width="340" Visibility="Collapsed"
                Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,10,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Library.PlaylistTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{loc:T playlist.hint}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" Width="32" Height="32"
                            ToolTip="{loc:T playlist.close}" Click="OnClosePlaylistClick" />
                </Grid>
                <ScrollViewer x:Name="PlaylistScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="PlaylistItems" Margin="6,0,6,12" Focusable="False">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="10,12,0,4"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ListRowButton}" CommandParameter="{Binding}"
                                        Tag="{Binding DataContext.Library, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Command="{Binding DataContext.Library.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:T playlist.toggleWatched}" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.ToggleWatchedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="StateIcon" FontFamily="{DynamicResource IconFont}" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ProgressLabel" Grid.Column="2" Text="{Binding ProgressText}" FontSize="11" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ProgressBar x:Name="Bar" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                     Style="{StaticResource ThinProgress}" Value="{Binding Progress}" Margin="0,5,0,0" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Progress}" Value="0">
                                        <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <!-- Ciklus 1 (M6b): pogledano = zelena kvačica, zeleni natpis i puna zelena traka. -->
                                    <DataTrigger Binding="{Binding Watched}" Value="True">
                                        <Setter TargetName="StateIcon" Property="Text" Value="&#xE73E;" />
                                        <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="ProgressLabel" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="StateIcon" Property="Text" Value="&#xE768;" />
                                        <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
