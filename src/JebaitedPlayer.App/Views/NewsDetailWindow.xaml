<Window x:Class="JebaitedPlayer.Views.NewsDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        Title="{loc:T news.title}" Width="500" SizeToContent="Height" MinHeight="200" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <!-- Detalji obavijesti: kategorija, naslov, objašnjenje i (ako postoji) radnja. Otvaranje označava obavijest pročitanom. -->
    <StackPanel Margin="24,20,24,18">
        <Border x:Name="TagBox" HorizontalAlignment="Left" CornerRadius="10" Padding="9,1">
            <TextBlock x:Name="TagText" FontSize="10.5" FontWeight="Bold" />
        </Border>
        <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="DetailText" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}" Content="{loc:T common.close}" IsCancel="True"
                    Click="OnCloseClick" />
            <Button x:Name="ActionButton" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="OnActionClick" />
        </StackPanel>
    </StackPanel>
</Window>
