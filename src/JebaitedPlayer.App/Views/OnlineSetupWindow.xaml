<Window x:Class="JebaitedPlayer.Views.OnlineSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        Title="{loc:T wizard.title}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Gumbi -->
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="22,0,22,16">
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource MenuBorderBrush}" Margin="0,0,0,14" />
            <TextBlock x:Name="PageCounter" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="18,8" Click="OnNext" Margin="8,0,0,0">
                <TextBlock x:Name="NextText" Text="{loc:T wizard.next}" FontWeight="SemiBold" />
            </Button>
            <Button x:Name="SkipButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T wizard.skip}" Click="OnSkip" Margin="8,0,0,0" />
            <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T wizard.back}" Click="OnBack" Margin="0" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="22,10,22,16">

                <!-- 1. Uvod -->
                <StackPanel x:Name="IntroPage">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T wizard.introTitle}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="{loc:T wizard.introText}" />
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{loc:T wizard.osRecommended}" FontWeight="SemiBold" />
                            <TextBlock x:Name="OsIntroText" Style="{StaticResource HintText}" Margin="0,2,0,8"
                                       Text="{loc:T wizard.osIntro}" />
                            <TextBlock Text="{loc:T wizard.subdlOptional}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,8"
                                       Text="{loc:T wizard.subdlIntro}" />
                            <TextBlock Text="{loc:T wizard.titloviOptional}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                       Text="{loc:T wizard.titloviIntro}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0"
                               Text="{loc:T wizard.securityHint}" />
                </StackPanel>

                <!-- 2. OpenSubtitles -->
                <StackPanel x:Name="OsPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="OpenSubtitles.com" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10"
                               Text="{loc:T wizard.osHaveAccount}" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource StepNumber}" Text="1." />
                        <StackPanel>
                            <TextBlock Style="{StaticResource StepText}" Text="{loc:T wizard.osStep1}" />
                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Content="{loc:T wizard.osOpenSignup}" Tag="https://www.opensubtitles.com/en/users/sign_up" Click="OnLinkClick" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource StepNumber}" Text="2." />
                        <TextBlock Style="{StaticResource StepText}" Text="{loc:T wizard.osStep2}" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource StepNumber}" Text="3." />
                        <TextBlock Style="{StaticResource StepText}" Text="{loc:T wizard.osStep3}" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource StepNumber}" Text="4." />
                        <TextBlock Style="{StaticResource StepText}" Text="{loc:T wizard.osStep4}" />
                    </DockPanel>
                    <Grid Margin="22,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:T sources.username}" VerticalAlignment="Center" />
                        <TextBox x:Name="OsUser" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="{loc:T sources.password}" VerticalAlignment="Center" />
                        <PasswordBox x:Name="OsPassword" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                        <TextBlock x:Name="OsKeyLabel" Grid.Row="2" Text="{loc:T sources.apiKey}" VerticalAlignment="Center" />
                        <DockPanel x:Name="OsKeyRow" Grid.Row="2" Grid.Column="1" Margin="0,3">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T wizard.paste}" Margin="6,0,0,0" Padding="10,4" Click="OnPasteOsKey" />
                            <PasswordBox x:Name="OsKey" />
                        </DockPanel>
                    </Grid>
                    <StackPanel x:Name="OsKeyHelp" Margin="22,6,0,0">
                        <TextBlock Style="{StaticResource HintText}" Margin="0"
                                   Text="{loc:T wizard.osKeyHelp}" />
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Content="{loc:T wizard.osOpenKeys}" Tag="https://www.opensubtitles.com/en/consumers" Click="OnLinkClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="22,12,0,0">
                        <Button x:Name="OsTestButton" Style="{StaticResource AccentButton}" Padding="16,7" Click="OnTestOpenSubtitles">
                            <TextBlock Text="{loc:T wizard.testAndSave}" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="OsStatus" TextWrapping="Wrap" Margin="22,8,0,0" />
                </StackPanel>

                <!-- 3. SubDL -->
                <StackPanel x:Name="SubDlPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T wizard.subdlTitle}" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource StepNumber}" Text="1." />
                        <StackPanel>
                            <TextBlock Style="{StaticResource StepText}" Text="{loc:T wizard.subdlStep1}" />
                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Content="{loc:T wizard.subdlOpen}" Tag="https://subdl.com/panel/api" Click="OnLinkClick" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource StepNumber}" Text="2." />
                        <TextBlock Style="{StaticResource StepText}" Text="{loc:T wizard.subdlStep2}" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource StepNumber}" Text="3." />
                        <TextBlock Style="{StaticResource StepText}" Text="{loc:T wizard.subdlStep3}" />
                    </DockPanel>
                    <DockPanel Margin="22,8,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T wizard.paste}" Margin="6,0,0,0" Padding="10,4" Click="OnPasteSubDlKey" />
                        <PasswordBox x:Name="SubDlKey" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="22,12,0,0">
                        <Button x:Name="SubDlTestButton" Style="{StaticResource AccentButton}" Padding="16,7" Click="OnTestSubDl">
                            <TextBlock Text="{loc:T wizard.testAndSave}" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="SubDlStatus" TextWrapping="Wrap" Margin="22,8,0,0" />
                </StackPanel>

                <!-- 4. Titlovi.com -->
                <StackPanel x:Name="TitloviPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T wizard.titloviTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10"
                               Text="{loc:T wizard.titloviHint}" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource StepNumber}" Text="1." />
                        <StackPanel>
                            <TextBlock Style="{StaticResource StepText}" Text="{loc:T wizard.titloviStep1}" />
                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Content="{loc:T wizard.titloviOpen}" Tag="https://titlovi.com/" Click="OnLinkClick" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource StepNumber}" Text="2." />
                        <TextBlock Style="{StaticResource StepText}" Text="{loc:T wizard.titloviStep2}" />
                    </DockPanel>
                    <Grid Margin="22,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:T sources.username}" VerticalAlignment="Center" />
                        <TextBox x:Name="TitloviUser" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="{loc:T sources.password}" VerticalAlignment="Center" />
                        <PasswordBox x:Name="TitloviPassword" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="22,12,0,0">
                        <Button x:Name="TitloviTestButton" Style="{StaticResource AccentButton}" Padding="16,7" Click="OnTestTitlovi">
                            <TextBlock Text="{loc:T wizard.testAndSave}" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="TitloviStatus" TextWrapping="Wrap" Margin="22,8,0,0" />
                </StackPanel>

                <!-- 5. Gotovo -->
                <StackPanel x:Name="DonePage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T wizard.doneTitle}" />
                    <TextBlock x:Name="DoneSummary" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,14,0,0"
                               Text="{loc:T wizard.laterHint}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
