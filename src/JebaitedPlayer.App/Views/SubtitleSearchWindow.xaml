<Window x:Class="JebaitedPlayer.Views.SubtitleSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:JebaitedPlayer.Infrastructure"
        Title="{loc:T search.title}"
        Width="780" Height="600" MinWidth="560" MinHeight="380" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <DockPanel Margin="18,14,18,14">
        <!-- Upit (može se ispraviti) -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{loc:T search.queryTitle}" Style="{StaticResource HintText}" Margin="0,0,0,3" />
                <TextBox x:Name="TitleBox" Text="{Binding QueryTitle, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="{loc:T search.year}" Style="{StaticResource HintText}" Margin="0,0,0,3" />
                <TextBox Text="{Binding QueryYear, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="{loc:T search.season}" Style="{StaticResource HintText}" Margin="0,0,0,3" />
                <TextBox Text="{Binding QuerySeason, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                <TextBlock Text="{loc:T search.episode}" Style="{StaticResource HintText}" Margin="0,0,0,3" />
                <TextBox Text="{Binding QueryEpisode, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <Button Grid.Column="4" Style="{StaticResource AccentButton}" Padding="18,7" VerticalAlignment="Bottom"
                    Command="{Binding SearchCommand}" IsDefault="True">
                <TextBlock Text="{loc:T search.search}" FontWeight="SemiBold" />
            </Button>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding ProviderStatus}" Style="{StaticResource HintText}" Margin="0,3,0,8" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="{loc:T settings.sources}" Click="OnSourcesClick" Margin="0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:T common.close}" Click="OnCloseClick" Margin="0" />
        </DockPanel>

        <Border BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource PanelBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Results}" Margin="6" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="6" Padding="10,8" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Badge" CornerRadius="4" Padding="5,2" Margin="0,2,10,0" VerticalAlignment="Top"
                                            HorizontalAlignment="Left" Background="{DynamicResource ButtonHoverBrush}">
                                        <TextBlock x:Name="BadgeText" Text="{Binding LanguageCode}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="Detail" Text="{Binding Details}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{loc:T search.load}" Margin="10,0,0,0"
                                            VerticalAlignment="Center" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.LoadCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="sure">
                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="likely">
                                    <Setter TargetName="Badge" Property="Background" Value="#C9A227" />
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#1A1405" />
                                </DataTrigger>
                                <!-- Zeleni redak samo za siguran najbolji rezultat, da boja ne obmanjuje. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBest}" Value="True" />
                                        <Condition Binding="{Binding Level}" Value="sure" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
